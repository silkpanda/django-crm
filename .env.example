# Copy to .env. Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# ---------------------------------------------------------------------------
# Branding
#
# Everything the app calls itself, plus its palette. All optional — with the
# whole block absent the app ships a neutral slate/teal shell and the wordmark
# "CRM". Uncomment and set the vars to re-brand it; there is no code and no CSS
# edit. README has the full list.
# ---------------------------------------------------------------------------

# Page <title>, browser name, admin header.
# BRAND_NAME=CRM

# The sidebar wordmark, and the accent word coloured beside it. Leave the
# accent empty for a single-word wordmark.
# BRAND_WORDMARK=CRM
# BRAND_WORDMARK_ACCENT=

# The small line at the bottom of the sidebar, after the name.
# BRAND_FOOTER=internal

# The team the no-login lead form (/leads/submit/) files leads under. Must be an
# existing lead source: Website (default), Sales, Support, Partners, Front desk.
# PUBLIC_LEAD_TEAM=Website

# The teams the staff desk form (/leads/new/) offers, comma-separated. Each must
# be an existing lead source; add new ones in the Django admin first.
# LEAD_TEAMS=Sales,Support,Partners,Front desk

# Envelope From address for outgoing mail. Defaults to "<BRAND_NAME> <crm@localhost>".
# BRAND_EMAIL_FROM=

# The palette. These override the defaults in static/css/tokens.css; a fork
# changes all seven or none. Anything unparseable falls back to the default
# rather than emitting broken CSS.
# BRAND_RED=#dc2626
# BRAND_RED_TEXT=#b91c1c
# BRAND_BLUE=#0d9488
# BRAND_BLUE_HOVER=#0f766e
# BRAND_BLUE_TEXT=#0f766e
# BRAND_NAVY=#1e293b
# BRAND_NAVY_2=#334155
